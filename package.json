{
  "name": "delulu-solul",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,api -c magenta,cyan \"vite\" \"node server/index.mjs\"",
    "dev:web": "vite",
    "dev:api": "node server/index.mjs",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "start": "node server/index.mjs",
    "smoke": "node scripts/smoke.mjs",
    "check:content": "tsx scripts/content-check.ts",
    "shots": "node scripts/shots.mjs",
    "icons": "node scripts/icons.mjs",
    "worker:dev": "wrangler dev",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.1.0",
    "@fontsource/lora": "^5.1.0",
    "@fontsource/manrope": "^5.1.0",
    "@hono/node-server": "^1.13.7",
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.9",
    "hono": "^4.6.10",
    "html-to-image": "^1.11.11",
    "lucide-react": "^0.454.0",
    "nanoid": "^5.0.9",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241106.0",
    "@types/node": "^22.8.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "postcss": "^8.4.47",
    "puppeteer-core": "^25.16.0",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "wrangler": "^3.90.0"
  }
}
